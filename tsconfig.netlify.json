{
  /* Le funzioni serverless in netlify/ non erano coperte da nessun tsconfig:
     tsconfig.app.json include solo "src", tsconfig.node.json solo
     "vite.config.ts". `npm run build` non le typecheckava mai — e sono
     proprio i file che parlano con l'esterno (chiave ORS, header CORS,
     inoltro a OpenRouteService). Scoperto il 2026-09-01 correggendo il bug
     CORS di route.ts, che ho dovuto verificare invocando tsc a mano.

     Progetto separato da tsconfig.node.json e non un semplice include in
     più: quello descrive il tooling di build (vite.config.ts, gira sulla
     macchina che compila), questo descrive un runtime di PRODUZIONE che
     gira sui server di Netlify. Contesti diversi, garanzie diverse: tenerli
     separati evita che un'opzione allentata per comodità di build finisca
     ad applicarsi anche al codice che serve richieste reali. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.netlify.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    /* fetch e process arrivano dai globals di Node (@types/node), non dal
       DOM: questa funzione non gira in un browser. */
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["netlify"]
}
