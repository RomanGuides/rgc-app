# Roman Guides Companion — variabili d'ambiente
#
# Copia questo file in .env (non .env.example) e inserisci la tua chiave reale.
# .env non viene mai versionato (vedi .gitignore).

# Chiave API OpenRouteService — necessaria per il calcolo dei percorsi
# pedonali nella Concierge Map ("Get Directions" dentro l'app).
# Gratuita, senza carta di credito: registrati su openrouteservice.org,
# crea un token, e incollalo qui sotto.
VITE_ORS_API_KEY=
